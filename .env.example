# Copie para .env e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis o app funciona
# offline: leitura, biblioteca e sons por palavras-chave, sem IA nem sincronização.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

